generator client {
  provider = "prisma-client-js"
}

// To use PostgreSQL instead, change provider to "postgresql"
// and update DATABASE_URL in .env. Nothing else needs to change.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMINISTRATOR")
  createdAt    DateTime @default(now())
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String      @db.Text  // Removed @default("")
  price       Float
  category    String      @default("Mains")
  tag         String      @default("")
  tagType     String      @default("")
  note        String      @default("")
  image       String      @default("")
  available   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Chef {
  id        Int      @id @default(autoincrement())
  name      String
  title     String   @default("")
  bio       String   @db.Text  // Removed @default("")
  specialty String   @default("")
  image     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// id looks like "SF-10482" (the frontend creates it at checkout)
model Order {
  id             String      @id
  customerName   String
  email          String      @default("")
  phone          String      @default("")
  orderType      String      @default("delivery")
  address        String      @default("")
  deliveryWindow String      @default("")
  notes          String      @db.Text  // Removed @default("")
  subtotal       Float       @default(0)
  deliveryFee    Float       @default(0)
  gst            Float       @default(0)
  total          Float       @default(0)
  status         String      @default("new") // new | preparing | on_the_way | completed | cancelled
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name       String
  price      Float
  qty        Int
  lineTotal  Float
}

// Messages from the public contact form
model Inquiry {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String   @default("")
  inquiryType String   @default("General Inquiry")
  subject     String   @default("")
  message     String   @db.Text
  status      String   @default("Unread") // Unread | Replied | Resolved
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Home and About page content, stored as one JSON document per page
model Content {
  page      String   @id // "home" | "about"
  data      Json
  updatedAt DateTime @updatedAt
}

model Image {
  id        Int      @id @default(autoincrement())
  url       String
  filename  String
  mimeType  String   @default("")
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String // order | message | system
  title     String
  text      String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}